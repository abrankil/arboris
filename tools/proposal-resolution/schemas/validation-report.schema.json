{"$schema":"http://json-schema.org/draft-07/schema#","$id":"arboris:proposal-resolution:map001:validation-report:r1","title":"Árboris MAP-001 Validation Report Contract R1","description":"Contrato estructural del reporte de validación para resolución cíclica de MAP-001 / navegación local. El reporte es producido y envuelto exclusivamente por validator/resolver; el agente no está autorizado a escribirlo. El status se deriva de findings según precedencia estructural: AUTHORITY_BLOCKER > OPEN_BLOCKER > REJECT_FIXABLE > PASS. Este esquema valida forma y coherencia estructural del status, no hashes reales, existencia de sourceRefs, correspondencia con la propuesta, ejecución efectiva del validador, autorización semántica de paths ni suficiencia del diagnóstico.","type":"object","additionalProperties":false,"required":["schemaVersion","reportId","reportType","control","status","findings"],"properties":{"schemaVersion":{"type":"string","const":"0.1"},"reportId":{"type":"string","pattern":"^MAP001-VAL-[0-9]{4,}$"},"reportType":{"type":"string","const":"MAP001_LOCAL_NAVIGATION_VALIDATION"},"control":{"type":"object","description":"Control-plane de procedencia. Debe ser construido por el resolver a partir de una ejecución real del validador.","additionalProperties":false,"required":["owner","runId","proposalBinding","authorityBinding","validatorBinding"],"properties":{"owner":{"type":"string","const":"RESOLVER"},"runId":{"type":"string","pattern":"^MAP001-RUN-[0-9]{4,}$"},"proposalBinding":{"type":"object","additionalProperties":false,"required":["proposalId","sha256","iteration"],"properties":{"proposalId":{"type":"string","pattern":"^MAP001-PROP-[0-9]{4,}$"},"sha256":{"$ref":"#/definitions/sha256"},"iteration":{"type":"integer","minimum":1}}},"authorityBinding":{"type":"object","description":"Identidad de la autoridad efectivamente usada para validar. Es una copia de trazabilidad, no una fuente de autoridad independiente.","additionalProperties":false,"required":["authorityId","authorityManifestSha256","sourceCandidate"],"properties":{"authorityId":{"type":"string","pattern":"^MAP-001-WALKABLE-ENVELOPE-AUTHORITY-[0-9]{3}$"},"authorityManifestSha256":{"$ref":"#/definitions/sha256"},"sourceCandidate":{"type":"object","additionalProperties":false,"required":["id","sha256"],"properties":{"id":{"type":"string","pattern":"^MAP-001-WALKABLE-ENVELOPE-CANDIDATE-[0-9]{3}$"},"sha256":{"$ref":"#/definitions/sha256"}}}}},"validatorBinding":{"type":"object","description":"Identidad de la implementación de validación que produjo los findings antes de ser envueltos por el resolver.","additionalProperties":false,"required":["validatorId","scope","implementationPath","implementationSha256"],"properties":{"validatorId":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9._-]{2,}$"},"scope":{"type":"string","const":"MAP001_LOCAL_NAVIGATION"},"implementationPath":{"type":"string","pattern":"^tools/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.mjs$"},"implementationSha256":{"$ref":"#/definitions/sha256"}}}}},"status":{"type":"string","enum":["PASS","REJECT_FIXABLE","OPEN_BLOCKER","AUTHORITY_BLOCKER"]},"findings":{"type":"array","items":{"$ref":"#/definitions/finding"},"uniqueItems":true}},"allOf":[{"if":{"properties":{"status":{"const":"PASS"}}},"then":{"properties":{"findings":{"maxItems":0}}}},{"if":{"properties":{"status":{"const":"REJECT_FIXABLE"}}},"then":{"properties":{"findings":{"minItems":1,"items":{"$ref":"#/definitions/autoRepairFinding"}}}}},{"if":{"properties":{"status":{"const":"OPEN_BLOCKER"}}},"then":{"properties":{"findings":{"minItems":1,"contains":{"properties":{"disposition":{"const":"OPEN_BLOCKER"}},"required":["disposition"]},"items":{"oneOf":[{"$ref":"#/definitions/autoRepairFinding"},{"$ref":"#/definitions/openBlockerFinding"}]}}}}},{"if":{"properties":{"status":{"const":"AUTHORITY_BLOCKER"}}},"then":{"properties":{"findings":{"minItems":1,"contains":{"properties":{"disposition":{"const":"AUTHORITY_BLOCKER"}},"required":["disposition"]}}}}}],"definitions":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"candidatePointer":{"type":"string","description":"JSON Pointer relativo exclusivamente a intent.candidate del proposal validado; se exige al menos un segmento.","minLength":2,"pattern":"^/(?:[^/~]|~0|~1)+(?:/(?:[^/~]|~0|~1)+)*$","allOf":[{"not":{"pattern":"(?:^|/)\\.(?:$|/)"}},{"not":{"pattern":"(?:^|/)\\.\\.(?:$|/)"}}]},"sourceRef":{"type":"string","minLength":1},"autoRepairFinding":{"type":"object","additionalProperties":false,"required":["findingId","disposition","code","message","sourceRefs","targetPaths","repairDirective"],"properties":{"findingId":{"type":"string","pattern":"^FND-[0-9]{3,}$"},"disposition":{"type":"string","const":"AUTO_REPAIR"},"code":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9._-]{2,}$"},"message":{"type":"string","minLength":1},"sourceRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/definitions/sourceRef"}},"targetPaths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/definitions/candidatePointer"},"description":"Paths afectados por el finding. Para AUTO_REPAIR, este conjunto es también el alcance máximo que una reparación referenciada por este finding puede modificar; E2.5 debe comprobarlo semánticamente."},"expected":{},"observed":{},"repairDirective":{"type":"object","additionalProperties":false,"required":["minimalChangeRequired"],"properties":{"minimalChangeRequired":{"type":"boolean","const":true},"hint":{"type":"string","minLength":1}}}}},"openBlockerFinding":{"type":"object","additionalProperties":false,"required":["findingId","disposition","code","message","sourceRefs","targetPaths","requiredAction"],"properties":{"findingId":{"type":"string","pattern":"^FND-[0-9]{3,}$"},"disposition":{"type":"string","const":"OPEN_BLOCKER"},"code":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9._-]{2,}$"},"message":{"type":"string","minLength":1},"sourceRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/definitions/sourceRef"}},"targetPaths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/definitions/candidatePointer"},"description":"Paths de intent.candidate afectados por el bloqueo. No constituyen autorización de reparación automática."},"expected":{},"observed":{},"requiredAction":{"type":"string","const":"HUMAN_DECISION_OR_NEW_EVIDENCE"}}},"authorityBlockerFinding":{"type":"object","additionalProperties":false,"required":["findingId","disposition","code","message","sourceRefs","targetPaths","requiredAction"],"properties":{"findingId":{"type":"string","pattern":"^FND-[0-9]{3,}$"},"disposition":{"type":"string","const":"AUTHORITY_BLOCKER"},"code":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9._-]{2,}$"},"message":{"type":"string","minLength":1},"sourceRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/definitions/sourceRef"}},"targetPaths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/definitions/candidatePointer"},"description":"Paths de intent.candidate afectados por el bloqueo. No constituyen autorización de reparación automática."},"expected":{},"observed":{},"requiredAction":{"type":"string","const":"AUTHORITY_REVIEW"}}},"finding":{"oneOf":[{"$ref":"#/definitions/autoRepairFinding"},{"$ref":"#/definitions/openBlockerFinding"},{"$ref":"#/definitions/authorityBlockerFinding"}]}}}