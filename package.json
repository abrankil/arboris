{
  "name": "arboris",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "npm run verify:botanical && npm run verify:data-access && npm run verify:reference-db && npm run test:canonical-identification && npm run test:asc && npm run test:map-blockout && npm run test:tile-grammar && npm run test:walkable-envelope && npm run test:reference-corpus",
    "verify:botanical": "python tools/botanical-data/validate_master_export.py && python tools/botanical-data/validate_species_ids.py && python tools/botanical-data/validate_species_data.py",
    "verify:data-access": "python tools/botanical-data/test_query_botanical.py",
    "verify:reference-db": "python tools/botanical-data/test_reference_sqlite.py",
    "build:botanical": "python tools/botanical-data/export_master.py && python tools/botanical-data/build_species_data.py",
    "build:reference-db": "python tools/botanical-data/build_reference_sqlite.py --force",
    "benchmark:reference-data": "python tools/botanical-data/build_reference_sqlite.py --force && node tools/botanical-data/benchmark_reference_access.mjs --json build/reference-benchmark.json --markdown build/reference-benchmark.md",
    "benchmark:ai-routing": "node tools/botanical-data/benchmark_ai_routing.mjs --json build/ai-routing-benchmark.json --markdown build/ai-routing-benchmark.md",
    "query:botanical": "python tools/botanical-data/query_botanical.py",
    "compile:asc": "node tools/asc/compile_asc.mjs",
    "test:asc": "node --test tools/asc/*.test.mjs",
    "test:canonical-identification": "node --test tools/canonical-identification/engine.test.mjs",
    "test:legacy-key": "node --test tools/botanical-key-validation/*.test.mjs",
    "materialize:map001": "node tools/map-blockout/materialize_map001_v02.mjs data/maps/map-001-blockout-candidate-002.json --out-dir build/map001-blockout-v02",
    "test:map-blockout": "npm run test:map-blockout:v01 && npm run test:map-blockout:v02",
    "validate:tile-grammar": "node tools/tile-grammar/validate_candidate_v02.mjs data/tiles/tile-grammar-candidate-v0.2.json",
    "test:tile-grammar": "node --test tools/tile-grammar/*.test.mjs",
    "stress:tile-grammar": "node tools/tile-grammar/stress_test_008.mjs",
    "validate:tile-grammar:v01": "node tools/tile-grammar/validate_candidate.mjs data/tiles/tile-grammar-candidate-v0.1.json",
    "validate:tile-grammar:v02": "node tools/tile-grammar/validate_candidate_v02.mjs data/tiles/tile-grammar-candidate-v0.2.json",
    "stress:tile-grammar:v01": "node tools/tile-grammar/stress_test_007.mjs",
    "stress:tile-grammar:v02": "node tools/tile-grammar/stress_test_008.mjs",
    "materialize:map001:v01": "node tools/map-blockout/materialize_map001.mjs data/maps/map-001-blockout-candidate-001.json --out-dir build/map001-blockout-v01",
    "materialize:map001:v02": "node tools/map-blockout/materialize_map001_v02.mjs data/maps/map-001-blockout-candidate-002.json --out-dir build/map001-blockout-v02",
    "test:map-blockout:v01": "node --test tools/map-blockout/materialize_map001.test.mjs",
    "test:map-blockout:v02": "node --test tools/map-blockout/materialize_map001_v02.test.mjs",
    "test:map001-tilegrammar-preintegration": "node --test tools/integration/*.test.mjs",
    "run:map001-tilegrammar-preintegration": "node tools/integration/map001_tilegrammar_preintegration_001.mjs",
    "test:walkable-envelope": "node --test tools/map-navigation/*.test.mjs",
    "materialize:walkable-envelope": "node tools/map-navigation/materialize_walkable_envelope_001.mjs --out-dir build/map001-walkable-envelope",
    "validate:walkable-envelope-migration": "node tools/map-navigation/materialize_walkable_envelope_001.mjs --mode migration --out-dir build/map001-walkable-envelope-migration",
    "test:reference-corpus": "node --test tools/reference-corpus/*.test.mjs"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
